# 中文说明：示例环境变量，复制为 .env 后按实际账户与环境填写。
PYTHONUNBUFFERED=1
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://weather:weather@db:5432/weather_trader
REDIS_URL=redis://redis:6379/0
POLYMARKET_WS_URL=wss://clob.polymarket.com/ws
POLYMARKET_REST_URL=https://clob.polymarket.com
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
WEATHER_API_BASE_URL=https://api.weather.gov
WUNDERGROUND_BASE_URL=https://www.wunderground.com/history/daily
ENGINE_LOOP_INTERVAL_SECONDS=5
WEATHER_REFRESH_SECONDS=300
MARKET_SUBSCRIBE_SYMBOLS=
DRY_RUN=true
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720
FRONTEND_API_BASE=http://localhost:8000
